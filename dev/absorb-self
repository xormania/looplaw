#!/usr/bin/env bash
# Derive this repository's own component manifest and absorb it, so the
# derive-absorb seam is exercised against a real graph rather than only
# a fixture.
#
# Four things, in order of what they catch:
#
#   1. the manifest matches the ratified shape, per the second producer
#   2. every source it names exists, and its digest is the file's — read
#      here rather than trusted, because the deriver is the only author
#      of those digests and nothing downstream can check them
#   3. the component set matches the packages that actually ship
#   4. the act renders it without refusing
#
# Step 2 exists because a self-consistent lie passed everything: an audit
# fabricated all 21 digests and this script's output line came out byte
# for byte identical. Provenance is what makes a derived statement
# falsifiable, and a digest nobody re-reads falsifies nothing. The check
# re-hashes with sha256sum rather than calling the deriver again — a
# deriver that verifies itself carries the same bug into both answers.
#
# The kernel cannot do this: it never reads a work tree. Verifying a
# manifest against the files it describes is the client's job, which is
# why it lives here and not in looplaw.
set -euo pipefail
cd "$(dirname "$0")/.."

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

dev/components >"$tmp/components.cue"
go run cuelang.org/go/cmd/cue export "$tmp/components.cue" -o "$tmp/components.json"
go run cuelang.org/go/cmd/cue vet ./schema/ "$tmp/components.json" -d '#ComponentManifest'

python3 - "$tmp/components.json" <<'PY'
import hashlib, json, subprocess, sys

m = json.load(open(sys.argv[1]))
components, depends = m["components"], m.get("depends", {})

# 2 · every claimed digest is the file's own.
bad = []
for name, c in sorted(components.items()):
    for path, claimed in sorted(c.get("sources", {}).items()):
        try:
            actual = hashlib.sha256(open(path, "rb").read()).hexdigest()
        except OSError as e:
            bad.append(f"{path}: named by {name}, unreadable ({e.strerror})")
            continue
        if actual != claimed:
            bad.append(f"{path}: manifest says {claimed[:12]}, file is {actual[:12]}")
if bad:
    print("the manifest's provenance does not match the tree:", file=sys.stderr)
    for b in bad:
        print("  " + b, file=sys.stderr)
    print("\n  A digest nobody re-reads falsifies nothing. Provenance is what\n"
          "  makes a derived statement checkable; fabricated, it is decoration.",
          file=sys.stderr)
    sys.exit(1)

# 3 · the component set is the set of packages that ship source.
listed = subprocess.run(
    ["go", "list", "-f", "{{.ImportPath}}|{{len .GoFiles}}", "./..."],
    capture_output=True, text=True, check=True).stdout.split()
module = subprocess.run(["go", "list", "-m"], capture_output=True, text=True,
                        check=True).stdout.strip()
real = set()
for row in listed:
    path, n = row.rsplit("|", 1)
    name = path[len(module) + 1:] if path.startswith(module + "/") else "."
    if name.startswith(("dev", "tools")) or n == "0":
        continue
    real.add(name)
missing, extra = real - set(components), set(components) - real
if missing or extra:
    print("the manifest does not describe this repository:", file=sys.stderr)
    for p in sorted(missing):
        print(f"  ships source and is not listed: {p}", file=sys.stderr)
    for p in sorted(extra):
        print(f"  listed and ships no source:     {p}", file=sys.stderr)
    sys.exit(1)

edges = sum(len(v) for v in depends.values())
print(f"derived: {len(components)} components, {edges} dependencies, "
      f"{sum(len(c.get('sources', {})) for c in components.values())} sources verified")
PY

go run ./cmd/looplaw absorb "$tmp/components.cue" >"$tmp/view.cue"
echo "absorbed: $(wc -l <"$tmp/view.cue") lines of draft view"
