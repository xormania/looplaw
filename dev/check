#!/usr/bin/env bash
# The same sequence CI's fast lane runs, in the same order, so a green
# run here means a green run there. Cheapest checks first: a typo
# should cost seconds, not a full suite.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n\033[1m== %s\033[0m\n' "$1"; }

# First, and before anything slow: if the design basis was changed
# without consent, that is what you need to know, not a gofmt diff.
step "design basis lock"
dev/lock

step "lanes"
dev/lanes

step "no machine paths in tracked files"
# A tracked file is read on machines that are not this one, where a path
# into somebody's home directory is unfollowable — and it publishes the
# layout of the machine it was written on, permanently, because history
# keeps it. AGENTS.md once sent every harness to a methods directory
# under a home directory: true on one machine, false everywhere else.
#
# Reads both lanes, because the leak lands in either — a brief, a schema
# doc, a refusal string. The hazard that keeps the vocabulary checks with
# the product (a check filtering on paths skips the file a product edit
# just changed) does not apply to one that greps every tracked file.
#
# The bracketed letters keep this file and the workflow from matching
# their own pattern, so nothing is excluded and the check covers itself.
# Machine-neutral locations stay: ~/.local/state/looplaw and
# $XDG_STATE_HOME name a convention rather than a machine.
leaked=$(git grep -nI -E '(/[h]ome/|/[U]sers/|/[r]oot/|~/[p]rojects/)' || true)
if [ -n "$leaked" ]; then
	echo "$leaked"
	echo
	echo "tracked text names a machine's filesystem — point inside the repository,"
	echo "or put the fact in proj/, which is gitignored"
	exit 1
fi

step "format"
if [ -n "$(gofmt -l .)" ]; then
	gofmt -l .
	echo "run: gofmt -w ."
	exit 1
fi

step "vet"
go vet ./...

step "build"
go build ./...

step "law and design basis (second producer)"
go run cuelang.org/go/cmd/cue vet ./schema/
go run cuelang.org/go/cmd/cue vet ./dev/

step "test"
go test ./...

step "derive and absorb this repository"
dev/absorb-self

step "recorded outputs match what the code emits"
# Compared against generated output, not against git: a change staged
# for this commit is intended, not stale, and CI checks the committed
# state separately.
go test ./... -run Golden -count=1
go run ./dev/cmd/digest > /tmp/looplaw-digest-check.md
diff -q /tmp/looplaw-digest-check.md dev/DIGEST.md >/dev/null || { echo "digest stale; run dev/basis"; exit 1; }

step "stray scratch files"
stray=$(git status --porcelain --untracked-files=all | grep -E '(^\?\? .*(zz_|scratch|tmp).*\.go$)' || true)
if [ -n "$stray" ]; then
	echo "$stray"
	echo "these get left behind; remove them before pushing"
	exit 1
fi

printf '\n\033[32mall checks passed\033[0m — race and the producer differential still run in CI\n'
